# Neon Postgres connection string (from neon.tech dashboard)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Admin dashboard password — set a strong secret before deploying
ADMIN_PASSWORD=your-secret-admin-password

# Multi-congregation rollout. Keep false until migrations and the first
# platform-owner account have been verified in production.
MULTI_TENANT_ENABLED=false

# At least 32 random characters. Used to encrypt the opaque auth session cookie.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Single-use bootstrap secret for /setup. It stops working after an owner exists.
PLATFORM_SETUP_TOKEN=replace-with-a-single-use-random-token

# Full public URL of your deployment (used for redirects)
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# GitHub personal access token with "Contents: Read and write" permission on
# urxio/contact-search. Used only by the admin "Name Feedback" panel to commit
# dictionary additions/removals directly to public/name-dictionary-cleaned-suggestion.txt.
# Server-side only — never exposed to the client.
GITHUB_TOKEN=ghp_your-token-here
